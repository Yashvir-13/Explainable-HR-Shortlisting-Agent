<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shortlist Report — Explainable HR Agent</title>
  <style>
    :root {
      --navy: #1a1f36;
      --blue: #2563eb;
      --blue-light: #eff6ff;
      --green: #0f7b3f;
      --green-bg: #ecfdf5;
      --amber: #9a6700;
      --amber-bg: #fffbeb;
      --red: #b42318;
      --red-bg: #fef2f2;
      --grey-50: #f9fafb;
      --grey-200: #e5e7eb;
      --grey-500: #6b7280;
      --grey-800: #1f2937;
      --white: #ffffff;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      color: var(--grey-800); background: var(--grey-50);
      line-height: 1.55; padding: 0;
    }

    /* ── Header band ────────────────────────────────── */
    .report-header {
      background: var(--navy); color: var(--white);
      padding: 2rem 3rem 1.6rem;
    }
    .report-header h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: 0.3rem; }
    .report-header p { font-size: 0.85rem; color: #94a3b8; }

    .container { max-width: 1080px; margin: 0 auto; padding: 2rem 3rem 3rem; }

    /* ── Section headings ───────────────────────────── */
    .section-title {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--blue); margin: 2.2rem 0 0.8rem;
      border-bottom: 2px solid var(--blue); display: inline-block;
      padding-bottom: 0.15rem;
    }

    /* ── Tables ──────────────────────────────────────── */
    table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1.5rem; font-size: 0.85rem; }
    th, td { padding: 0.55rem 0.8rem; text-align: left; vertical-align: top; }
    thead th { background: var(--navy); color: var(--white); font-weight: 600; font-size: 0.78rem; }
    tbody tr:nth-child(even) { background: var(--white); }
    tbody tr:nth-child(odd) { background: var(--grey-50); }
    tbody td { border-bottom: 1px solid var(--grey-200); }

    /* ── Requirement chips ──────────────────────────── */
    .req-table th { background: var(--grey-50); color: var(--grey-500); font-weight: 600; width: 170px; font-size: 0.8rem; }
    .req-table td { background: var(--white); }
    .req-table tr { border-bottom: 1px solid var(--grey-200); }

    /* ── Recommendation badges ──────────────────────── */
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 700; font-size: 0.78rem; }
    .badge-hire   { background: var(--green-bg); color: var(--green); }
    .badge-hold   { background: var(--amber-bg); color: var(--amber); }
    .badge-no_hire { background: var(--red-bg); color: var(--red); }

    /* ── Candidate detail cards ─────────────────────── */
    .candidate-card {
      background: var(--white); border: 1px solid var(--grey-200);
      border-radius: 8px; padding: 1.5rem 1.8rem; margin-bottom: 1.5rem;
    }
    .candidate-card h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
    .candidate-meta { font-size: 0.82rem; color: var(--grey-500); margin-bottom: 1rem; }

    /* ── Score bar ───────────────────────────────────── */
    .score-bar-track { background: var(--grey-200); border-radius: 4px; height: 8px; width: 100%; }
    .score-bar-fill { border-radius: 4px; height: 8px; }
    .fill-high { background: var(--green); }
    .fill-mid { background: var(--amber); }
    .fill-low { background: var(--red); }

    .evidence { font-size: 0.75rem; color: var(--grey-500); font-style: italic; margin-top: 0.15rem; }
    .gaps-list { margin: 0.5rem 0; padding-left: 1.2rem; }
    .gaps-list li { font-size: 0.82rem; color: var(--red); margin-bottom: 0.2rem; }
    .strengths-list { margin: 0.5rem 0; padding-left: 1.2rem; }
    .strengths-list li { font-size: 0.82rem; color: var(--green); margin-bottom: 0.2rem; }

    .footer { text-align: center; font-size: 0.72rem; color: var(--grey-500); margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--grey-200); }
  </style>
</head>
<body>

<div class="report-header">
  <h1>Explainable HR Shortlist Report</h1>
  <p>AI-generated evaluation  ·  Human review is required before any hiring decision</p>
</div>

<div class="container">

  <div class="section-title">Job Requirements</div>
  <table class="req-table">
    <tr><th>Role</th><td>{{ requirements.role_title }}</td></tr>
    <tr><th>Domain</th><td>{{ requirements.domain }}</td></tr>
    <tr><th>Seniority</th><td>{{ requirements.seniority }}</td></tr>
    <tr><th>Must-have skills</th><td>{{ requirements.must_have_skills | join(", ") }}</td></tr>
    <tr><th>Nice-to-have</th><td>{{ requirements.nice_to_have_skills | join(", ") or "—" }}</td></tr>
    <tr><th>Min. experience</th><td>{{ requirements.min_years_experience }} years</td></tr>
    <tr><th>Education</th><td>{{ requirements.education | join(", ") or "—" }}</td></tr>
    <tr><th>Certifications</th><td>{{ requirements.certifications | join(", ") or "—" }}</td></tr>
  </table>

  <div class="section-title">Ranked Candidates</div>
  <table>
    <thead>
      <tr>
        <th>#</th><th>Candidate</th><th>Total</th><th>Recommendation</th>
        <th>Skills</th><th>Experience</th><th>Education</th><th>Projects</th><th>Communication</th>
      </tr>
    </thead>
    <tbody>
      {% for c in ranked_candidates %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><strong>{{ c.name }}</strong></td>
        <td><strong>{{ "%.1f"|format(c.weighted_total) }}</strong>/10</td>
        <td><span class="badge badge-{{ c.recommendation }}">{{ c.recommendation | replace("_", " ") | upper }}</span></td>
        {% for s in c.scores %}
        <td>{{ s.score }}/10</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% for c in ranked_candidates %}
  <div class="candidate-card">
    <h3>{{ loop.index }}. {{ c.name }}</h3>
    <div class="candidate-meta">
      Total: <strong>{{ "%.1f"|format(c.weighted_total) }}/10</strong>  ·
      <span class="badge badge-{{ c.recommendation }}">{{ c.recommendation | replace("_", " ") | upper }}</span>  ·
      Confidence: {{ "%.0f"|format(c.confidence * 100) }}%
    </div>

    <table>
      <thead>
        <tr><th>Dimension</th><th>Weight</th><th>Score</th><th>Weighted</th><th style="width:45%">Justification</th></tr>
      </thead>
      <tbody>
        {% for s in c.scores %}
        <tr>
          <td>{{ s.dimension }}</td>
          <td>{{ "%.0f"|format(s.weight * 100) }}%</td>
          <td>
            {{ s.score }}/10
            <div class="score-bar-track">
              <div class="score-bar-fill {% if s.score >= 7 %}fill-high{% elif s.score >= 4 %}fill-mid{% else %}fill-low{% endif %}"
                   style="width: {{ s.score * 10 }}%;"></div>
            </div>
          </td>
          <td>{{ "%.2f"|format(s.weighted_score) }}</td>
          <td>
            {{ s.justification }}
            {% if s.evidence %}
            <div class="evidence">Evidence: {{ s.evidence | join(", ") }}</div>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if c.strengths %}
    <strong style="color: var(--green); font-size: 0.82rem;">Strengths</strong>
    <ul class="strengths-list">
      {% for s in c.strengths %}<li>{{ s }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if c.gaps %}
    <strong style="color: var(--red); font-size: 0.82rem;">Gaps</strong>
    <ul class="gaps-list">
      {% for g in c.gaps %}<li>{{ g }}</li>{% endfor %}
    </ul>
    {% endif %}

    <p style="font-size: 0.85rem; margin-top: 0.6rem; padding: 0.6rem; background: var(--blue-light); border-radius: 4px;">
      {{ c.overall_justification }}
    </p>
  </div>
  {% endfor %}

  <div class="footer">
    Explainable HR Shortlisting Agent  ·  This report is for decision support only
  </div>
</div>

</body>
</html>
